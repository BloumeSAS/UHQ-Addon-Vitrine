# ─── UHQ Vitrine Addon — Variables d'environnement ───────────────────────────────
# Copier ce fichier en .env et ajuster les valeurs.

# Port du microservice (par défaut : 3106)
PORT=3106

# URL du panel UHQ (nom du site, logo, thème, catégories et pays disponibles)
PANEL_URL=http://localhost:8000

# Clé API MAÎTRE du panel (Paramètres → Clé API) : lecture des catégories/pays et sauvegarde.
PANEL_API_KEY=

# URL de l'addon Orders (catalogue de produits) — facultatif : sans lui, la vitrine n'affiche pas de produits.
ORDERS_URL=http://localhost:3102

# Fichier JSON servant de base de données (configuration de la vitrine)
DB_PATH=./vitrine-data.json

NODE_ENV=development
